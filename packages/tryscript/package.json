{
  "name": "tryscript",
  "version": "0.0.1",
  "description": "Golden testing for CLI applications - TypeScript port of trycmd",
  "license": "MIT",
  "author": "Joshua Levy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlevy/tryscript.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tryscript": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:self": "tsx src/bin.ts",
    "test:golden": "node dist/bin.mjs run 'tests/**/*.tryscript.md'",
    "test:golden:coverage": "c8 --src src --all --include 'dist/**' --reporter text --reporter html --reports-dir coverage-golden node dist/bin.mjs run 'tests/**/*.tryscript.md'",
    "test:coverage": "vitest run --coverage",
    "test:all:coverage": "pnpm test:golden:coverage && pnpm test:coverage",
    "publint": "publint",
    "prepack": "pnpm build",
    "tryscript": "tsx src/bin.ts"
  },
  "dependencies": {
    "atomically": "^2.0.0",
    "commander": "^14.0.0",
    "diff": "^8.0.0",
    "fast-glob": "^3.3.0",
    "picocolors": "^1.1.0",
    "strip-ansi": "^7.1.0",
    "tree-kill": "^1.2.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "c8": "^10.1.3",
    "publint": "^0.3.0",
    "tsdown": "^0.18.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
