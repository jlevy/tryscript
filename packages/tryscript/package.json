{
  "name": "tryscript",
  "version": "0.1.3",
  "description": "Golden testing for CLI applications - TypeScript port of trycmd",
  "license": "MIT",
  "author": "Joshua Levy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlevy/tryscript.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tryscript": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "copy-docs": "cp ../../README.md . && mkdir -p docs && cp ../../docs/tryscript-reference.md docs/",
    "build": "pnpm copy-docs && tsdown",
    "prepare": "pnpm copy-docs",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:self": "tsx src/bin.ts",
    "test:golden": "node dist/bin.mjs run 'tests/**/*.tryscript.md'",
    "test:coverage:vitest": "vitest run --coverage",
    "test:coverage:tryscript": "node dist/bin.mjs run 'tests/**/*.tryscript.md' --coverage --coverage-reporter text --coverage-reporter lcov",
    "test:coverage:merge": "mkdir -p coverage-merged && npx lcov-result-merger 'coverage*/lcov.info' coverage-merged/lcov.info && echo 'Merged coverage written to coverage-merged/lcov.info'",
    "test:coverage": "pnpm test:coverage:vitest && pnpm test:coverage:tryscript && pnpm test:coverage:merge",
    "publint": "publint",
    "prepack": "pnpm build",
    "tryscript": "tsx src/bin.ts"
  },
  "dependencies": {
    "atomically": "^2.0.0",
    "commander": "^14.0.0",
    "diff": "^8.0.0",
    "fast-glob": "^3.3.0",
    "picocolors": "^1.1.0",
    "strip-ansi": "^7.1.0",
    "tree-kill": "^1.2.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "c8": ">=10.0.0",
    "lcov-result-merger": ">=5.0.0",
    "monocart-coverage-reports": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "c8": {
      "optional": true
    },
    "lcov-result-merger": {
      "optional": true
    },
    "monocart-coverage-reports": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "c8": "^10.1.3",
    "lcov-result-merger": "^5.0.1",
    "monocart-coverage-reports": "^2.12.9",
    "publint": "^0.3.0",
    "tsdown": "^0.18.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
