{
  "name": "tryscript",
  "version": "0.1.7",
  "description": "Markdown golden tests for CLI applications",
  "license": "MIT",
  "author": "Joshua Levy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlevy/tryscript.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tryscript": "./dist/bin.mjs"
  },
  "files": [
    "LICENSE",
    "dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "copy-docs": "node scripts/copy-docs.mjs",
    "build": "pnpm copy-docs && tsdown",
    "prepare": "pnpm copy-docs",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:self": "tsx src/bin.ts",
    "test:golden": "node dist/bin.mjs run 'tests/**/*.tryscript.md'",
    "test:coverage:vitest": "vitest run --coverage",
    "test:coverage:tryscript": "node dist/bin.mjs run 'tests/**/*.tryscript.md' --coverage --merge-lcov coverage/lcov.info",
    "test:coverage": "pnpm test:coverage:vitest && pnpm test:coverage:tryscript",
    "publint": "publint && pnpm test:package",
    "test:package": "node scripts/package-smoke.mjs && pnpm test:compat",
    "test:compat": "node scripts/v0-1-7-compatibility-smoke.mjs",
    "prepack": "pnpm build",
    "tryscript": "tsx src/bin.ts"
  },
  "dependencies": {
    "atomically": "^2.0.0",
    "commander": "^14.0.3",
    "diff": "^8.0.4",
    "fast-glob": "^3.3.0",
    "picocolors": "^1.1.0",
    "strip-ansi": "^7.1.0",
    "tree-kill": "^1.2.0",
    "tsx": "4.23.1",
    "yaml": "^2.9.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "c8": ">=10.0.0",
    "monocart-coverage-reports": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "c8": {
      "optional": true
    },
    "monocart-coverage-reports": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/diff": "7.0.2",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.10",
    "c8": "10.1.3",
    "monocart-coverage-reports": "2.12.12",
    "publint": "0.3.22",
    "tsdown": "0.21.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
