{
  "name": "tryscript-workspace",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm --filter tryscript test:self",
    "test:unit": "pnpm -r test",
    "test:self": "pnpm --filter tryscript test:self",
    "test:golden": "pnpm -r test:golden",
    "test:coverage": "pnpm -r test:coverage",
    "publint": "pnpm -r publint",
    "format": "prettier --write --log-level warn .",
    "format:check": "prettier --check --log-level warn .",
    "lint": "eslint . --fix && pnpm typecheck && eslint . --max-warnings 0",
    "lint:check": "pnpm typecheck && eslint . --max-warnings 0",
    "precommit": "pnpm format && pnpm lint:check && pnpm test",
    "tryscript": "pnpm --filter tryscript tryscript",
    "prepare": "lefthook install",
    "changeset": "changeset",
    "changeset:add": "node scripts/changeset-add.mjs",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm publint && changeset publish",
    "upgrade:check": "ncu --format group",
    "upgrade": "ncu --target minor -u && pnpm install && pnpm test",
    "upgrade:major": "ncu --target latest --interactive --format group"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.1.10",
    "npm-check-updates": "^17.1.18",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "micromatch>picomatch": "^2.3.2"
    }
  }
}
