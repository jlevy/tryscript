save-workspace-protocol=true
prefer-workspace-packages=true

# NOTE: the supply-chain cool-off gate (`minimumReleaseAge`) is deliberately NOT set
# here. pnpm 10.34.5 reads the value back via `pnpm config get` but does not apply it
# during resolution, and pnpm 11 ignores unknown .npmrc keys entirely -- so setting it
# in this file looks like a control while enforcing nothing. It lives in
# pnpm-workspace.yaml, which is verified to gate on both pnpm 10 and 11.
# See SUPPLY-CHAIN-SECURITY.md.
